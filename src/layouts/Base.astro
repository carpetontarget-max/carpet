---
import { getImage } from 'astro:assets';
import '@fontsource-variable/plus-jakarta-sans';
// Same file the @font-face above resolves to (Vite emits it once), so the
// preload below starts the download early without fetching it twice.
import jakartaLatinUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { site, links, areas, services, withBase, businessSchemaId } from '../config';
import heroImg from '../images/hero-equipment.png';

interface Props {
  title?: string;
  titleFull?: string;
  description?: string;
  image?: ImageMetadata;
  // Override the auto-generated breadcrumb trail (e.g. to insert an
  // intermediate "Services" step on /services/<slug> pages). Each `path` is
  // site-root-relative ('/services/foo'), resolved to an absolute URL below.
  breadcrumbs?: { name: string; path: string }[];
  // Utility pages (the 404): "noindex" and no canonical — every real page gets
  // a self-referencing, query-free canonical (so ?utm_ visits aren't duplicates).
  noindex?: boolean;
}
const { title, titleFull, description, image, breadcrumbs, noindex } = Astro.props as Props;
const pageTitle = titleFull ?? (title ? `${title} | ${site.businessName}` : `${site.businessName} | ${site.tagline}`);
const pageDescription = description ?? `${site.tagline}. Serving ${site.serviceArea} with eco-friendly hot water extraction and a satisfaction guarantee.`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const optimizedOgImage = await getImage({ src: image ?? heroImg, width: 1200, format: 'jpg' });
const ogImage = new URL(optimizedOgImage.src, Astro.site);
const isHome = Astro.url.pathname === withBase('/');
const businessId = businessSchemaId(Astro.site);

// ── Breadcrumb structured data ──
// Skipped on the homepage (a single "Home" crumb isn't a meaningful trail).
// Every other page defaults to Home > <title>; pages needing a deeper trail
// (e.g. Home > Services > Carpet Cleaning) pass `breadcrumbs` explicitly.
const crumbs =
  isHome
    ? null
    : (breadcrumbs ?? [{ name: 'Home', path: '/' }, { name: title ?? pageTitle, path: Astro.url.pathname }]);
const breadcrumbList = crumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: String(new URL(withBase(c.path), Astro.site)),
  })),
};

// ── LocalBusiness structured data (JSON-LD) ──
// Real profiles only: an unset handle falls back to the bare platform homepage
// (see `link()` in config.ts), which must not be claimed as our profile.
const sameAs = [links.instagram, links.facebook, site.googleReviewsUrl]
  .filter((u) => u && !/^https:\/\/(instagram|facebook)\.com\/?$/.test(u));
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  // schema.org has no carpet-cleaning subtype, so name the category for
  // machines (search engines, AI assistants) via a well-known entity URL.
  additionalType: 'https://en.wikipedia.org/wiki/Carpet_cleaning',
  '@id': businessId,
  name: site.googleBusinessName,
  alternateName: site.businessName,
  image: String(ogImage),
  url: String(Astro.site),
  telephone: site.phoneIntl,
  email: site.email,
  priceRange: '££',
  knowsAbout: ['Carpet cleaning', 'Hot water extraction', 'Upholstery cleaning', 'Rug cleaning', 'Stain removal', 'Pet odour removal'],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phoneIntl,
    email: site.email,
    contactType: 'customer service',
    areaServed: 'GB',
    availableLanguage: 'English',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Leicester',
    addressRegion: 'Leicestershire',
    addressCountry: 'GB',
  },
  // Ties this site to the Google Business Profile listing (local-pack entity).
  hasMap: site.googleReviewsUrl,
  areaServed: areas.map((a) => ({ '@type': 'City', name: a })),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: site.hoursSchema.opens,
    closes: site.hoursSchema.closes,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.googleRating,
    reviewCount: site.googleReviewCount,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Carpet & upholstery cleaning services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        url: String(new URL(withBase(`/services/${s.slug}`), Astro.site)),
      },
    })),
  },
  sameAs,
};

// WebSite entity (homepage only) — helps Google show the business name as the
// site name above search results.
const webSite = isHome && {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.googleBusinessName,
  alternateName: site.businessName,
  url: String(Astro.site),
  publisher: { '@id': businessId },
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Speed: fetch the brand font early, plus any page-specific preloads
         (e.g. the homepage hero image) passed in via slot="head". -->
    <link rel="preload" href={jakartaLatinUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <!-- Google Analytics (renders only when a measurement ID is configured) -->
    <GoogleAnalytics />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.businessName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {breadcrumbList && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbList)} />}
    {webSite && <script type="application/ld+json" set:html={JSON.stringify(webSite)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingContact />
  </body>
</html>
