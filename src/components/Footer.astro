---
import { site, links, hasMessenger, withBase } from '../config';
import { areaPages } from '../areaPages';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <Logo variant="light" />
      <p style="margin-top:16px;max-width:340px;">{site.tagline}. Serving {site.serviceArea} with eco-friendly hot water extraction and a satisfaction guarantee.</p>
      <div class="social-row">
        <a href={links.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" size={18} /></a>
        {hasMessenger && <a href={links.messenger} target="_blank" rel="noopener" aria-label="Messenger"><Icon name="messenger" size={18} /></a>}
        <a href={links.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} /></a>
        <a href={links.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={18} /></a>
      </div>
    </div>
    <div>
      <h2 class="footer-h">Explore</h2>
      <p>
        <a href={withBase('/residential')}>Residential</a><br />
        <a href={withBase('/commercial')}>Commercial</a><br />
        <a href={withBase('/services')}>Services</a><br />
        <a href={withBase('/areas')}>Areas we cover</a><br />
        <a href={withBase('/about')}>About</a><br />
        <a href={withBase('/faq')}>FAQ</a>
      </p>
    </div>
    <div>
      <h2 class="footer-h">Contact</h2>
      <p>
        <a href={links.tel}>{site.phoneDisplay}</a><br />
        <a href={links.sms}>Text us</a><br />
        <a href={links.email}>{site.email}</a>
      </p>
    </div>
    <div>
      <h2 class="footer-h">Opening Hours</h2>
      <p>
        {site.hours.map((h) => (<span>{h.day}: {h.time}<br /></span>))}
      </p>
    </div>
  </div>
  <!-- Sitewide links to every local area page (local SEO internal linking) -->
  <div class="container footer-areas">
    <h2 class="footer-h">Carpet cleaning near you</h2>
    <p>
      {areaPages.map((a, i) => (
        <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={withBase(`/areas/${a.slug}`)}>{a.name}</a></>
      ))}
    </p>
  </div>
  <div class="container footer-bottom">
    © 2026 {site.googleBusinessName}. All rights reserved.
  </div>
</footer>
