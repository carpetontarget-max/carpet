---
/**
 * Google Analytics 4 (gtag.js) — loads ONLY when a real measurement ID is set.
 *
 * Set your ID either way (the env var wins if both are set):
 *   1. Env var  →  PUBLIC_GA_ID=G-XXXXXXXXXX  in your .env  (recommended)
 *   2. Config   →  site.googleAnalyticsId in src/config.ts
 *
 * A GA4 measurement ID is NOT a secret — it has to reach the browser — so the
 * PUBLIC_ prefix is correct (Astro only exposes PUBLIC_* env vars client-side).
 *
 * When no real ID is set (empty, or the "G-XXXXXXXXXX" placeholder), this
 * renders nothing — so local dev, previews and un-configured builds stay
 * analytics-free with zero extra requests.
 */
import { site } from '../config';

const gaId = (import.meta.env.PUBLIC_GA_ID || site.googleAnalyticsId || '').trim();

// A real GA4 ID looks like "G-XXXXXXXXXX". Treat the literal placeholder (and
// anything not starting with "G-") as "not configured yet".
const enabled = gaId.startsWith('G-') && gaId !== 'G-XXXXXXXXXX';
---
{enabled && (
  <>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      // define:vars wraps this script in a function, so gtag isn't global by
      // default — expose it for page scripts (e.g. the homepage quote form).
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId);

      // Speed: fetch gtag.js (~176 KB) only once the page has loaded, so it
      // doesn't compete with the hero image and font on slow mobile data.
      // Calls made before then wait in dataLayer and are sent when it arrives.
      window.addEventListener('load', function () {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        document.head.appendChild(s);
      });

      // Enquiry tracking: every tap on WhatsApp, Messenger, call, text or email
      // is sent to Analytics as a 'generate_lead' event with the method used and
      // the page it happened on. Mark generate_lead as a key event in GA4
      // (Admin > Events) to see enquiries per page, town and traffic source.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var method = '';
        if (href.indexOf('tel:') === 0) method = 'call';
        else if (href.indexOf('sms:') === 0) method = 'text';
        else if (href.indexOf('mailto:') === 0) method = 'email';
        else if (/wa\.me|whatsapp\.com/.test(href)) method = 'whatsapp';
        else if (/m\.me\//.test(href)) method = 'messenger';
        if (!method) return;
        gtag('event', 'generate_lead', {
          method: method,
          link_text: (a.getAttribute('aria-label') || a.textContent || '').trim().slice(0, 100),
          page_path: location.pathname,
          transport_type: 'beacon'
        });
      }, true);
    </script>
  </>
)}
