---
import Base from '../layouts/Base.astro';
import { site, links, hasMessenger } from '../config';
import Icon from '../components/Icon.astro';

const photoMessage = encodeURIComponent(
  "Hi On Target, here are photos of the job I'd like quoted.",
);
const whatsappPhotos = `https://wa.me/${site.whatsappNumber}?text=${photoMessage}`;
---
<Base title="Contact" description="Talk to On Target Carpet Cleaning on WhatsApp, phone, text or email — same-day replies, seven days a week.">
  <section class="section">
    <div class="container" style="max-width:820px;">
      <div class="center reveal">
        <span class="eyebrow">Get in touch</span>
        <h1>Talk to us.</h1>
        <p class="lead">Same-day replies, seven days a week.</p>
      </div>

      <!-- WhatsApp: the one primary action -->
      <a href={links.whatsapp} class="channel-card channel-card--primary reveal">
        <span class="channel-card__icon"><Icon name="whatsapp" size={26} /></span>
        <span class="channel-card__body">
          <span class="channel-card__label">WhatsApp</span>
          <span class="channel-card__note">Fastest. Usually replied within the hour.</span>
        </span>
        <span class="channel-card__cta">Chat now →</span>
      </a>

      <!-- Everything else: outline cards -->
      <div class="grid grid--3" style="margin-top:16px;">
        <a href={links.tel} class="channel-card reveal">
          <span class="channel-card__icon"><Icon name="phone" size={22} /></span>
          <span class="channel-card__body">
            <span class="channel-card__label">Call</span>
            <span class="channel-card__phone">{site.phoneDisplay}</span>
            <span class="channel-card__note">Every day, 5am–1am.</span>
          </span>
        </a>
        <a href={links.sms} class="channel-card reveal">
          <span class="channel-card__icon"><Icon name="sms" size={22} /></span>
          <span class="channel-card__body">
            <span class="channel-card__label">Text</span>
            <span class="channel-card__note">Send your postcode and rooms.</span>
          </span>
        </a>
        <a href={links.email} class="channel-card reveal">
          <span class="channel-card__icon"><Icon name="email" size={22} /></span>
          <span class="channel-card__body">
            <span class="channel-card__label">Email</span>
            <span class="channel-card__note">Best for landlords and letting agents.</span>
          </span>
        </a>
      </div>

      <!-- Secondary channels -->
      <div class={`grid ${hasMessenger ? 'grid--2' : ''} reveal`} style="margin-top:16px;">
        {hasMessenger && (
          <a href={links.messenger} target="_blank" rel="noopener" class="channel-card channel-card--small">
            <span class="channel-card__icon"><Icon name="messenger" size={18} /></span>
            <span class="channel-card__label">Messenger</span>
          </a>
        )}
        <a href={links.instagram} target="_blank" rel="noopener" class="channel-card channel-card--small">
          <span class="channel-card__icon"><Icon name="instagram" size={18} /></span>
          <span class="channel-card__label">Instagram</span>
        </a>
      </div>

      <!-- The one input worth asking for -->
      <div class="photo-quote reveal">
        <h2>Not sure what it'll cost? Send us a photo.</h2>
        <p>Snap the carpet, the stain or the sofa and we'll come back with a proper price. No visit needed, no obligation.</p>
        <a href={whatsappPhotos} class="btn btn--wa" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={17} /> Send photos on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
