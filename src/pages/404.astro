---
import Base from '../layouts/Base.astro';
import { links, withBase } from '../config';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" description="Sorry — we couldn't find that page. Head back to the homepage or get in touch for a free carpet cleaning quote." noindex>
  <section class="section">
    <div class="container" style="max-width:640px;">
      <div class="center reveal">
        <span class="eyebrow">404</span>
        <h1>We couldn’t find that page</h1>
        <p class="lead">The page you’re after may have moved or no longer exists. Let’s get you back on track — or message us for a fast, free quote.</p>
        <div class="btn-row" style="justify-content:center;">
          <a href={withBase('/')} class="btn btn--primary">Back to homepage</a>
          <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> WhatsApp a quote</a>
        </div>
      </div>
    </div>
  </section>
</Base>
