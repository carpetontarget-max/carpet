---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site, links, services, areas, withBase, businessSchemaId } from '../../config';
import { servicePages } from '../../servicePages';
import { areaPages } from '../../areaPages';
import Icon from '../../components/Icon.astro';

export function getStaticPaths() {
  return services.map((s) => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;
const page = servicePages[service.slug]; // long-form content, if written for this slug
const related = service.related
  .map((slug) => services.find((s) => s.slug === slug))
  .filter(Boolean);
const paragraphs = service.intro.split('\n\n');

const h1 = page?.h1 ?? `${service.title} in Leicester`;
const heroLead = page?.lead ?? service.desc;

const faqSchema = page?.faqs && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: h1,
  serviceType: service.title,
  description: page?.metaDescription ?? service.metaDescription,
  url: String(new URL(withBase(`/services/${service.slug}`), Astro.site)),
  provider: { '@id': businessSchemaId(Astro.site) },
  areaServed: areas.map((a) => ({ '@type': 'City', name: a })),
};
---
<Base
  title={page ? undefined : `${service.title} in Leicester`}
  titleFull={page?.metaTitle}
  description={page?.metaDescription ?? service.metaDescription}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: service.title, path: `/services/${service.slug}/` },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- HERO -->
  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="align-items:center;gap:48px;">
        <div class="reveal reveal--left">
          <span class="eyebrow">{service.icon} Our services</span>
          <h1>{h1}</h1>
          <p class="lead" style="margin-left:0;">{heroLead}</p>
          {!page && paragraphs.map((p) => <p>{p}</p>)}
          <div class="btn-row" style="margin-top:24px;">
            <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> WhatsApp for a quote</a>
            <a href={withBase('/#pricing')} class="btn btn--ghost">See pricing</a>
          </div>
        </div>
        {service.img ? (
          <Image
            src={service.img}
            alt={service.alt}
            loading="eager"
            fetchpriority="high"
            width={800}
            format="webp"
            style="width:100%;height:auto;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);object-fit:cover;aspect-ratio:4/3;"
          />
        ) : (
          /* PHOTO: swap this coloured panel for a real <Image> once you have one */
          <div class="ph-photo reveal reveal--right" style={`aspect-ratio:4/3;min-height:0;background:${service.tint};`}>
            <span class="ph-cap">{service.icon} {service.title} — photo to follow</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- LONG-FORM ARTICLE (only for slugs with servicePages content) -->
  {page && (
    <section class="section" style="padding-top:0;">
      <div class="container article">
        {page.sections.map((sec) => (
          <div class="reveal">
            <h2>{sec.h2}</h2>
            {sec.body.map((p) => <p>{p}</p>)}
            {sec.list && <ul class="ticklist">{sec.list.map((li) => <li>{li}</li>)}</ul>}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- WHY ON TARGET -->
  <section class="section section--mist">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Why On Target</span>
        <h2>Every job comes with the same standard</h2>
      </div>
      <div class="grid grid--4" style="text-align:left;">
        <div class="card reveal"><span class="icon">🌿</span><h3>Eco-friendly</h3><p>Safe, non-toxic solutions for kids and pets.</p></div>
        <div class="card reveal"><span class="icon">✅</span><h3>Guaranteed</h3><p>Not happy with an area? We'll put it right.</p></div>
        <div class="card reveal"><span class="icon">💧</span><h3>Fast drying</h3><p>Most carpets touch-dry within 4–6 hours.</p></div>
        <div class="card reveal"><span class="icon">💷</span><h3>Fixed price</h3><p>Agreed before we start — no surprises.</p></div>
      </div>
      <p class="center" style="margin-top:32px;">Read more about how we work on the <a href={withBase('/about')}>About page</a>, or head to <a href={withBase('/contact')}>Contact</a> to book directly.</p>
    </div>
  </section>

  <!-- FAQs (only for slugs with servicePages content) -->
  {page?.faqs && (
    <section class="section">
      <div class="container" style="max-width:820px;">
        <div class="center reveal">
          <span class="eyebrow">FAQ</span>
          <h2>{service.title} — your questions answered</h2>
        </div>
        {page.faqs.map((f) => (
          <div class="faq reveal">
            <button class="faq-q" aria-expanded="false">
              <span>{f.q}</span>
              <span class="faq-plus" aria-hidden="true"></span>
            </button>
            <div class="faq-a"><div class="faq-a-inner"><p>{f.a}</p></div></div>
          </div>
        ))}
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section section--mist">
      <div class="container">
        <div class="center reveal">
          <span class="eyebrow">Related services</span>
          <h2>You might also need</h2>
        </div>
        <div class="grid grid--3">
          {related.map((r) => (
            <a href={withBase(`/services/${r.slug}`)} class="card reveal" style="display:block;">
              <h3>{r.icon} {r.title}</h3>
              <p>{r.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- AREAS: links every service page to the local area pages -->
  <section class="section">
    <div class="container center">
      <span class="eyebrow">Where we offer this</span>
      <h2>{service.title} across Leicestershire</h2>
      <p class="lead">Local, family-run and based in Leicester — find your area below.</p>
      <div class="areas" style="justify-content:center;max-width:820px;margin:24px auto 0;">
        {areaPages.map((a) => <a href={withBase(`/areas/${a.slug}`)}>{a.name}</a>)}
      </div>
    </div>
  </section>

  <section class="section section--deep center">
    <div class="container">
      <h2>Ready to book {service.title.toLowerCase()}?</h2>
      <p class="lead">Get a fast, free quote today — call, text or message us however suits you.</p>
      <div class="btn-row" style="justify-content:center;">
        <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> WhatsApp us</a>
        <a href={links.tel} class="btn btn--onDark"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  {page?.faqs && (
    <script is:inline>
      document.querySelectorAll('.faq-q').forEach((btn) => {
        btn.addEventListener('click', () => {
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          btn.parentElement.classList.toggle('open', !open);
        });
      });
    </script>
  )}
</Base>
