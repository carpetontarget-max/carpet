---
import Base from '../layouts/Base.astro';
import { links, faqs } from '../config';
import Icon from '../components/Icon.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title="FAQ" description="Answers to common questions about our carpet and upholstery cleaning service in Leicester — methods, drying time, guarantee and coverage area.">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="section">
    <div class="container" style="max-width:760px;">
      <div class="center">
        <span class="eyebrow">FAQ</span>
        <h1>Frequently asked questions</h1>
      </div>
      {faqs.map((f, i) => (
        <div class="faq reveal" style={`transition-delay:${Math.min(i, 6) * 0.06}s`}>
          <button class="faq-q" aria-expanded="false">
            <span>{f.q}</span>
            <span class="faq-plus" aria-hidden="true"></span>
          </button>
          <div class="faq-a">
            <div class="faq-a-inner"><p>{f.a}</p></div>
          </div>
        </div>
      ))}
      <div class="center" style="margin-top:32px;">
        <p>Still have a question?</p>
        <div class="btn-row" style="justify-content:center;">
          <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> Ask on WhatsApp</a>
          <a href="/contact" class="btn btn--primary">Contact us</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('.faq-q').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.parentElement.classList.toggle('open', !open);
      });
    });
  </script>
</Base>
