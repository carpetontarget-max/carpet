---
import Base from '../layouts/Base.astro';
import { site, links, services, steps, stats, certifications, pricing, areas } from '../config';
import GoogleReviews from '../components/GoogleReviews.astro';
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <img src="/images/hero-equipment.png" alt="" aria-hidden="true" class="hero-bg" />
    <div class="container hero-grid">
      <div>
        <span class="pill"><span class="stars">★★★★★</span> Trusted by homeowners across {site.serviceArea}</span>
        <h1>Carpets & upholstery that look&nbsp;<span style="color:var(--brand-light)">brand new</span></h1>
        <p class="lead" style="margin-left:0;">
          Premium deep cleaning with eco-friendly hot water extraction. Fast free quotes,
          flexible scheduling and a satisfaction guarantee — {site.serviceArea}.
        </p>
        <div class="btn-row">
          <a href={links.whatsapp} class="btn btn--wa">💬 WhatsApp a quote</a>
          <a href={links.tel} class="btn btn--onDark">📞 {site.phoneDisplay}</a>
        </div>
        <div class="hero-badges">
          {certifications.map((c) => <span class="badge">✓ {c}</span>)}
        </div>
      </div>

      <!-- Quote card -->
      <div class="quote-card">
        <h3>Get your free quote</h3>
        <p class="muted">Enter your postcode and we'll get straight back to you.</p>
        <form action="/contact" method="get">
          <div class="field">
            <input name="postcode" placeholder="Your postcode (e.g. LE2 6...)" aria-label="Postcode" />
            <button class="btn btn--primary" type="submit">Go</button>
          </div>
        </form>
        <div class="btn-row" style="margin-top:6px;">
          <a href={links.whatsapp} class="btn btn--wa" style="flex:1;justify-content:center;">💬 WhatsApp</a>
          <a href={links.messenger} class="btn btn--primary" style="flex:1;justify-content:center;">📨 Messenger</a>
        </div>
        <p class="muted" style="margin:12px 0 0;text-align:center;">Same-day replies · No obligation</p>
      </div>
    </div>
  </section>

  <!-- CERTIFICATION STRIP -->
  <section style="padding:26px 0;border-bottom:1px solid var(--line);">
    <div class="container logos">
      <span class="cert"><span class="dot">●</span> Fully Insured</span>
      <span class="cert"><span class="dot">●</span> ★★★★★ 5.0 Rating</span>
      <span class="cert"><span class="dot">●</span> Eco-Friendly</span>
      <span class="cert"><span class="dot">●</span> Satisfaction Guarantee</span>
      <span class="cert"><span class="dot">●</span> DBS-Checked Team</span>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">What we do</span>
        <h2>Our cleaning services</h2>
        <p class="lead">From deep carpet cleaning to stubborn pet stains, we bring your soft furnishings back to life.</p>
      </div>
      <div class="grid grid--3">
        {services.map((s) => (
          <a href="/services" class="svc-card reveal">
            <img src={s.img} alt={s.title} loading="lazy" width="490" height="300" />
            <div class="overlay"></div>
            <div class="body">
              <span class="chip">{s.icon} Service</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="center" style="margin-top:36px;">
        <a href="/services" class="btn btn--ghost">See all services →</a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section--mist">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Simple & easy</span>
        <h2>How it works</h2>
        <p class="lead">Four easy steps from first message to spotless carpets.</p>
      </div>
      <div class="grid grid--4">
        {steps.map((s, i) => (
          <div class="step reveal">
            <div class="num">{i + 1}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER -->
  <section class="section">
    <div class="container center">
      <span class="eyebrow">See the difference</span>
      <h2>Before &amp; after</h2>
      <p class="lead">Drag the slider to reveal the transformation. Swap in your own photos anytime.</p>
      <div class="ba" id="ba">
        <!-- Base layer = AFTER (clean); fills the frame -->
        <img class="layer" src="/images/after.jpg" alt="Sofa after professional cleaning" width="800" height="600" style="background:linear-gradient(135deg,var(--brand),var(--brand-2));" />
        <!-- Reveal layer = BEFORE (dirty); clipped to the left of the handle -->
        <img class="layer" id="baReveal" src="/images/before.jpg" alt="Sofa before cleaning" width="800" height="600" style="background:linear-gradient(135deg,#6b7b73,#40514c);" />
        <span class="tag l">Before</span>
        <span class="tag r">After</span>
        <div class="handle" id="baHandle"></div>
        <input type="range" min="0" max="100" value="50" id="baRange" aria-label="Drag to compare before and after cleaning" />
      </div>
    </div>
  </section>

  <!-- STATS (dark band) -->
  <section class="section section--deep">
    <div class="container grid grid--4">
      {stats.map((s) => (
        <div class="stat reveal">
          <div class="big">{s.big}</div>
          <div class="label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- PRICING -->
  <section class="section section--mist">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Transparent pricing</span>
        <h2>Simple, honest prices</h2>
        <p class="lead">Indicative prices below — message us for an exact quote for your home.</p>
      </div>
      <div class="grid grid--3">
        {pricing.map((p) => (
          <div class={`card price-card reveal ${p.featured ? 'featured' : ''}`}>
            {p.featured && <span class="ribbon">Best value</span>}
            <h3>{p.name}</h3>
            <div class="price">£{p.price} <small>{p.unit}</small></div>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            <a href={links.whatsapp} class={`btn ${p.featured ? 'btn--primary' : 'btn--ghost'}`} style="width:100%;justify-content:center;">Get this quote</a>
          </div>
        ))}
      </div>
      <p class="center" style="margin-top:18px;font-size:.9rem;">Prices are guides only and depend on room size and condition. Minimum charges may apply.</p>
    </div>
  </section>

  <!-- GOOGLE REVIEWS (real, build-time) -->
  <section class="section">
    <div class="container">
      <GoogleReviews />
    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section class="section section--mist">
    <div class="container center">
      <span class="eyebrow">Coverage</span>
      <h2>Areas we cover</h2>
      <p class="lead">Proudly serving {site.serviceArea}. Not listed? Ask — we likely cover you.</p>
      <div class="areas" style="justify-content:center;max-width:820px;margin:0 auto;">
        {areas.map((a) => <span>{a}</span>)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--deep center">
    <div class="container">
      <h2>Ready for fresher, cleaner carpets?</h2>
      <p class="lead">Get a fast, free quote today — call, text or message us however suits you.</p>
      <div class="btn-row" style="justify-content:center;">
        <a href={links.whatsapp} class="btn btn--wa">💬 WhatsApp</a>
        <a href={links.sms} class="btn btn--gold">✉️ Text us</a>
        <a href={links.tel} class="btn btn--onDark">📞 {site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const range = document.getElementById('baRange');
      const reveal = document.getElementById('baReveal');
      const handle = document.getElementById('baHandle');
      if (!range) return;
      const update = () => {
        const v = range.value;
        // reveal the BEFORE (dirty) image from the left edge up to the handle
        reveal.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
        handle.style.left = v + '%';
      };
      range.addEventListener('input', update);
      update();
    })();
  </script>
</Base>
