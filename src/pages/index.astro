---
import Base from '../layouts/Base.astro';
import { site, links, services, steps, stats, certifications, pricing, areas } from '../config';
import GoogleReviews from '../components/GoogleReviews.astro';
import Icon from '../components/Icon.astro';
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <img src="/images/hero-equipment.png" alt="" aria-hidden="true" class="hero-bg" />
    <div class="hero-blobs" id="heroBlobs">
      <span class="hero-blob hero-blob--1"></span>
      <span class="hero-blob hero-blob--2"></span>
      <span class="hero-blob hero-blob--3"></span>
    </div>
    <div class="container hero-grid">
      <div class="reveal reveal--left">
        <span class="pill"><span class="stars">★★★★★</span> Trusted by homeowners across {site.serviceArea}</span>
        <h1>Carpets & upholstery that look&nbsp;<span style="color:var(--brand-light)">brand new</span></h1>
        <p class="lead" style="margin-left:0;">
          Premium deep cleaning with eco-friendly hot water extraction. Fast free quotes,
          flexible scheduling and a satisfaction guarantee — {site.serviceArea}.
        </p>
        <div class="btn-row">
          <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> WhatsApp a quote</a>
          <a href={links.tel} class="btn btn--onDark"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
        </div>
        <div class="hero-badges">
          {certifications.map((c) => <span class="badge">✓ {c}</span>)}
        </div>
      </div>

      <!-- Quote card -->
      <div class="quote-card reveal reveal--right" style="transition-delay:.12s">
        <h3>Get your free quote</h3>
        <p class="muted">Enter your postcode and we'll get straight back to you.</p>
        <form action="/contact" method="get">
          <div class="field">
            <input name="postcode" placeholder="Your postcode (e.g. LE2 6...)" aria-label="Postcode" />
            <button class="btn btn--primary" type="submit">Go</button>
          </div>
        </form>
        <div class="btn-row" style="margin-top:6px;">
          <a href={links.whatsapp} class="btn btn--wa" style="flex:1;justify-content:center;"><Icon name="whatsapp" size={17} /> WhatsApp</a>
          <a href={links.messenger} class="btn btn--primary" style="flex:1;justify-content:center;"><Icon name="messenger" size={17} /> Messenger</a>
        </div>
        <p class="muted" style="margin:12px 0 0;text-align:center;">Same-day replies · No obligation</p>
      </div>
    </div>
  </section>

  <!-- CERTIFICATION STRIP -->
  <section style="padding:26px 0;border-bottom:1px solid var(--line);">
    <div class="container logos">
      <span class="cert"><span class="dot">●</span> Fully Insured</span>
      <span class="cert"><span class="dot">●</span> ★★★★★ 5.0 Rating</span>
      <span class="cert"><span class="dot">●</span> Eco-Friendly</span>
      <span class="cert"><span class="dot">●</span> Satisfaction Guarantee</span>
      <span class="cert"><span class="dot">●</span> DBS-Checked Team</span>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">What we do</span>
        <h2>Our cleaning services</h2>
        <p class="lead">From deep carpet cleaning to stubborn pet stains, we bring your soft furnishings back to life.</p>
      </div>
      <div class="grid grid--3">
        {services.map((s) => (
          <a href="/services" class="svc-card reveal">
            <img src={s.img} alt={s.title} loading="lazy" width="490" height="300" onerror="this.remove()" />
            <div class="overlay"></div>
            <div class="body">
              <span class="chip">{s.icon} Service</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="center" style="margin-top:36px;">
        <a href="/services" class="btn btn--ghost">See all services →</a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section--mist">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Simple & easy</span>
        <h2>How it works</h2>
        <p class="lead">Four easy steps from first message to spotless carpets.</p>
      </div>
      <div class="grid grid--4">
        {steps.map((s, i) => (
          <div class="step reveal">
            <div class="num">{i + 1}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER -->
  <section class="section">
    <div class="container center">
      <span class="eyebrow">See the difference</span>
      <h2>Before &amp; after</h2>
      <p class="lead">Real results from our jobs — drag each slider to reveal the transformation.</p>
      <div class="ba-row">
        <!-- Sofa -->
        <figure class="ba-item">
          <div class="ba landscape" data-ba>
            <img class="layer" src="/images/after.jpg" alt="Sofa after professional cleaning" width="800" height="600" style="background:linear-gradient(135deg,var(--brand),var(--brand-2));" />
            <img class="layer ba-reveal" src="/images/before.jpg" alt="Sofa before cleaning" width="800" height="600" style="background:linear-gradient(135deg,#6b7b73,#40514c);" />
            <span class="tag l">Before</span>
            <span class="tag r">After</span>
            <div class="handle"></div>
            <input type="range" min="0" max="100" value="50" class="ba-range" aria-label="Sofa before and after slider" />
          </div>
          <figcaption>Upholstery deep clean</figcaption>
        </figure>
        <!-- Stairs -->
        <figure class="ba-item">
          <div class="ba portrait" data-ba>
            <img class="layer" src="/images/stairs-after.jpg" alt="Stairs after professional cleaning" width="640" height="1067" style="background:linear-gradient(135deg,var(--brand),var(--brand-2));" />
            <img class="layer ba-reveal" src="/images/stairs-before.jpg" alt="Stairs before cleaning" width="640" height="1067" style="background:linear-gradient(135deg,#6b7b73,#40514c);" />
            <span class="tag l">Before</span>
            <span class="tag r">After</span>
            <div class="handle"></div>
            <input type="range" min="0" max="100" value="50" class="ba-range" aria-label="Stairs before and after slider" />
          </div>
          <figcaption>Stairs &amp; landing clean</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- STATS (dark band) -->
  <section class="section section--deep">
    <div class="container grid grid--4">
      {stats.map((s) => (
        <div class="stat reveal">
          <div class="big">{s.big}</div>
          <div class="label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- PRICING -->
  <section class="section section--mist">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Transparent pricing</span>
        <h2>Simple, honest prices</h2>
        <p class="lead">Indicative prices below — message us for an exact quote for your home.</p>
      </div>
      <div class="grid grid--3">
        {pricing.map((p) => (
          <div class={`card price-card reveal ${p.featured ? 'featured' : ''}`}>
            {p.featured && <span class="ribbon">Best value</span>}
            <h3>{p.name}</h3>
            <div class="price">£{p.price} <small>{p.unit}</small></div>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            <a href={links.whatsapp} class={`btn ${p.featured ? 'btn--primary' : 'btn--ghost'}`} style="width:100%;justify-content:center;">Get this quote</a>
          </div>
        ))}
      </div>
      <p class="center" style="margin-top:18px;font-size:.9rem;">Prices are guides only and depend on room size and condition. Minimum charges may apply.</p>
    </div>
  </section>

  <!-- GOOGLE REVIEWS (real, build-time) -->
  <section class="section">
    <div class="container">
      <GoogleReviews />
    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section class="section section--mist">
    <div class="container center">
      <span class="eyebrow">Coverage</span>
      <h2>Areas we cover</h2>
      <p class="lead">Proudly serving {site.serviceArea}. Not listed? Ask — we likely cover you.</p>
      <div class="areas" style="justify-content:center;max-width:820px;margin:0 auto;">
        {areas.map((a) => <span>{a}</span>)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--deep center">
    <div class="container">
      <h2>Ready for fresher, cleaner carpets?</h2>
      <p class="lead">Get a fast, free quote today — call, text or message us however suits you.</p>
      <div class="btn-row" style="justify-content:center;">
        <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> WhatsApp</a>
        <a href={links.sms} class="btn btn--gold"><Icon name="sms" size={17} /> Text us</a>
        <a href={links.tel} class="btn btn--onDark"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-ba]').forEach((ba) => {
      const range = ba.querySelector('.ba-range');
      const reveal = ba.querySelector('.ba-reveal');
      const handle = ba.querySelector('.handle');
      if (!range) return;
      const update = () => {
        const v = range.value;
        // reveal the BEFORE (dirty) image from the left edge up to the handle
        reveal.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
        handle.style.left = v + '%';
      };
      range.addEventListener('input', update);
      update();
    });

    // Animated count-up for the stats band
    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
    function animateStat(el) {
      const text = el.textContent.trim();
      const m = text.match(/^([\d,.]+)(.*)$/);
      if (!m) return;
      const target = parseFloat(m[1].replace(/,/g, ''));
      const decimals = m[1].includes('.') ? m[1].split('.')[1].length : 0;
      const suffix = m[2];
      const duration = 1100;
      const start = performance.now();
      function tick(now) {
        const p = Math.min((now - start) / duration, 1);
        const val = target * easeOutCubic(p);
        el.textContent = val.toLocaleString('en-GB', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    const statIo = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { animateStat(e.target); statIo.unobserve(e.target); }
      });
    }, { threshold: 0.4 });
    document.querySelectorAll('.stat .big').forEach((el) => statIo.observe(el));

    // Subtle mouse-parallax on the hero's floating decorative shapes
    const heroSection = document.querySelector('.hero');
    const heroBlobs = document.getElementById('heroBlobs');
    if (heroSection && heroBlobs && matchMedia('(hover: hover)').matches) {
      heroSection.addEventListener('mousemove', (e) => {
        const r = heroSection.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        heroBlobs.style.transform = `translate(${x * 24}px, ${y * 24}px)`;
      });
      heroSection.addEventListener('mouseleave', () => { heroBlobs.style.transform = ''; });
    }
  </script>
</Base>
