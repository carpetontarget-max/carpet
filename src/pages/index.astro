---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, links, services, steps, stats, trustBadges, educate, whyChooseUs, pricing, areas, withBase } from '../config';
import GoogleReviews from '../components/GoogleReviews.astro';
import Icon from '../components/Icon.astro';
import heroImg from '../images/hero-equipment.png';
import sofaAfter from '../images/after.jpg';
import sofaBefore from '../images/before.jpg';
import stairsAfterImg from '../images/stairs-after.jpg';
import stairsBeforeImg from '../images/stairs-before.jpg';

const photoMessage = encodeURIComponent("Hi On Target, here are photos of the job I'd like quoted.");
const whatsappPhotos = `https://wa.me/${site.whatsappNumber}?text=${photoMessage}`;

// A focused set of the most-requested services for the homepage grid.
// The full range (including rug, mattress and curtain) lives on /services.
const homeFeatured = ['carpet-deep-cleaning', 'stain-spot-removal', 'pet-stain-odour-removal', 'upholstery-cleaning', 'stairs-landing-cleaning', 'end-of-tenancy-cleaning'];
const homeServices = homeFeatured.map((slug) => services.find((s) => s.slug === slug)).filter(Boolean);
---
<Base
  title="Carpet & Upholstery Cleaning in Leicester"
  description="Professional carpet, upholstery and rug cleaning across Leicester and Leicestershire. Eco-friendly hot water extraction, free quotes, satisfaction guaranteed."
>
  <!-- HERO -->
  <section class="hero">
    <Image src={heroImg} alt="" aria-hidden="true" class="hero-bg" width={1400} format="webp" loading="eager" />
    <div class="hero-blobs" id="heroBlobs">
      <span class="hero-blob hero-blob--1"></span>
      <span class="hero-blob hero-blob--2"></span>
      <span class="hero-blob hero-blob--3"></span>
    </div>
    <div class="container hero-grid">
      <div class="reveal reveal--left">
        <span class="pill"><span class="stars">★★★★★</span> Rated 5.0 by {site.googleReviewCount} local customers</span>
        <h1>The <span style="color:var(--brand-light)">healthier, deeper</span> carpet &amp; upholstery clean in Leicester</h1>
        <p class="lead" style="margin-left:0;">
          Bringing carpets, rugs and upholstery back to life with professional hot water extraction —
          outstanding results across {site.serviceArea}.
        </p>
        <div class="btn-row">
          <a href={links.whatsapp} class="btn btn--wa btn--lg"><Icon name="whatsapp" size={18} /> WhatsApp a quote</a>
          <a href={links.tel} class="btn btn--onDark btn--lg"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
        </div>
        <div class="hero-badges">
          <span class="badge">🛡️ <b>Fully insured</b></span>
          <span class="badge">🌿 <b>Eco-friendly</b></span>
          <span class="badge">✅ <b>Satisfaction guarantee</b></span>
          <span class="badge">🏠 <b>Local & family run</b></span>
        </div>
      </div>

      <!-- Quote card -->
      <div class="quote-card reveal reveal--right" style="transition-delay:.12s">
        <div class="quote-card__head">
          <h2>Get your free quote</h2>
          <span class="quote-free">No obligation</span>
        </div>
        <p class="muted">Tell us a little about the job and we'll come straight back with a price.</p>
        <form id="quoteForm" action={links.whatsapp} method="get">
          <div class="field">
            <label for="qf-name">Name</label>
            <input id="qf-name" name="name" placeholder="Your name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="qf-phone">Phone</label>
            <input id="qf-phone" name="phone" type="tel" placeholder="Best number to reach you" autocomplete="tel" required />
          </div>
          <div class="field">
            <label for="qf-postcode">Postcode</label>
            <input id="qf-postcode" name="postcode" placeholder="e.g. LE2 6..." autocomplete="postal-code" required />
          </div>
          <div class="field">
            <label for="qf-message">What needs cleaning?</label>
            <textarea id="qf-message" name="message" placeholder="e.g. lounge, stairs & a 3-seater sofa"></textarea>
          </div>
          <button class="btn btn--wa btn--submit" type="submit"><Icon name="whatsapp" size={17} /> Get My Free Quote</button>
        </form>
        <p class="quote-card__foot">We reply fast — usually within the hour, 7 days a week.</p>
        <div class="quote-card__photo">
          📸 <span>Faster quote? <a href={whatsappPhotos}>Send us a photo on WhatsApp</a></span>
        </div>
      </div>
    </div>
  </section>

  <!-- PREMIUM TRUST BADGES -->
  <section class="section--tight" style="border-bottom:1px solid var(--line);">
    <div class="container">
      <div class="trust-cards">
        {trustBadges.map((b) => (
          <div class="trust-badge reveal">
            <span class="tb-ico">{b.icon}</span>
            <span class="tb-label">{b.label}</span>
            <span class="tb-note">{b.note}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">What we do</span>
        <h2>Our cleaning services</h2>
        <p class="lead">From deep carpet cleaning to stubborn pet stains, we bring your soft furnishings back to life.</p>
      </div>
      <div class="grid grid--3">
        {homeServices.map((s) => (
          <a href={withBase(`/services/${s.slug}`)} class="svc-card reveal" style={s.img ? undefined : `background:${s.tint};`}>
            {s.img && <Image src={s.img} alt={s.alt} loading="lazy" width={700} format="webp" />}
            <div class="overlay"></div>
            <div class="body">
              <span class="chip">{s.icon} Service</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="center" style="margin-top:36px;">
        <a href={withBase('/services')} class="btn btn--ghost">See all services →</a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section--mist">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Simple & easy</span>
        <h2>How it works</h2>
        <p class="lead">Four easy steps from first message to spotless carpets.</p>
      </div>
      <div class="grid grid--4">
        {steps.map((s, i) => (
          <div class="step reveal">
            <div class="num">{i + 1}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE PROFESSIONAL DIFFERENCE (authority / education) -->
  <section class="section">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">The professional difference</span>
        <h2>Why professional cleaning beats a hired machine</h2>
        <p class="lead">A quick look at what actually gets your carpets clean — and why the pros do it differently.</p>
      </div>
      <div class="grid grid--3">
        {educate.map((e) => (
          <div class="card edu-card reveal">
            <span class="edu-ico">{e.icon}</span>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER -->
  <section class="section section--mist">
    <div class="container center">
      <span class="eyebrow">See the difference</span>
      <h2>Before &amp; after</h2>
      <p class="lead">Real results from our jobs — drag each slider to reveal the transformation.</p>
      <div class="ba-row">
        <!-- Sofa -->
        <figure class="ba-item">
          <div class="ba landscape" data-ba>
            <Image class="layer" src={sofaAfter} alt="Sofa upholstery after professional cleaning in Leicester" width={900} format="webp" loading="lazy" style="background:linear-gradient(135deg,var(--brand),var(--brand-2));" />
            <Image class="layer ba-reveal" src={sofaBefore} alt="Sofa upholstery before cleaning, showing dirt and staining" width={900} format="webp" loading="lazy" style="background:linear-gradient(135deg,#6b7b73,#40514c);" />
            <span class="tag l">Before</span>
            <span class="tag r">After</span>
            <div class="handle"></div>
            <input type="range" min="0" max="100" value="50" class="ba-range" aria-label="Sofa before and after slider" />
          </div>
          <figcaption>Upholstery deep clean</figcaption>
        </figure>
        <!-- Stairs -->
        <figure class="ba-item">
          <div class="ba portrait" data-ba>
            <Image class="layer" src={stairsAfterImg} alt="Stair carpet after professional cleaning, pile restored" width={700} format="webp" loading="lazy" style="background:linear-gradient(135deg,var(--brand),var(--brand-2));" />
            <Image class="layer ba-reveal" src={stairsBeforeImg} alt="Stair carpet before cleaning, flattened and worn" width={700} format="webp" loading="lazy" style="background:linear-gradient(135deg,#6b7b73,#40514c);" />
            <span class="tag l">Before</span>
            <span class="tag r">After</span>
            <div class="handle"></div>
            <input type="range" min="0" max="100" value="50" class="ba-range" aria-label="Stairs before and after slider" />
          </div>
          <figcaption>Stairs &amp; landing clean</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- STATS (dark band) -->
  <section class="section section--deep">
    <div class="container grid grid--4">
      {stats.map((s) => (
        <div class="stat reveal">
          <div class="big">{s.big}</div>
          <div class="label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="section">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Why choose us</span>
        <h2>Why Leicester chooses On Target</h2>
        <p class="lead">Plenty of companies can spray water on a carpet. Here's what keeps our customers coming back.</p>
      </div>
      <div class="grid grid--3">
        {whyChooseUs.map((w) => (
          <div class="card reveal">
            <span class="icon">{w.icon}</span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section section--mist" id="pricing">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Transparent pricing</span>
        <h2>Simple, honest prices</h2>
        <p class="lead">What we actually charge for typical jobs — not a lowball number to get you on the phone.</p>
      </div>
      <div class="grid grid--3">
        {pricing.map((p) => (
          <div class={`card price-card reveal ${p.featured ? 'featured' : ''}`}>
            {p.featured && <span class="ribbon">Best value</span>}
            <h3>{p.name}</h3>
            <div class="price">£{p.price} <small>{p.unit}</small></div>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            <a href={links.whatsapp} class={`btn ${p.featured ? 'btn--wa' : 'btn--ghost'}`} style="width:100%;justify-content:center;">Get this quote</a>
          </div>
        ))}
      </div>
      <p class="center" style="margin-top:18px;font-size:.9rem;">What moves the price: room size, level of soiling, stairs, and whether furniture needs moving.</p>
      <p class="center" style="margin-top:.4em;font-size:.9rem;font-weight:700;color:var(--ink);">Fixed price agreed before we start. No surprises on the day.</p>
    </div>
  </section>

  <!-- GOOGLE REVIEWS (real, build-time) -->
  <section class="section">
    <div class="container">
      <GoogleReviews />
    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section class="section section--mist">
    <div class="container center">
      <span class="eyebrow">Coverage</span>
      <h2>Areas we cover</h2>
      <p class="lead">Proudly serving {site.serviceArea}. Not listed? Ask — we likely cover you.</p>
      <div class="areas" style="justify-content:center;max-width:820px;margin:0 auto;">
        {areas.map((a) => <a href={withBase('/services/carpet-deep-cleaning')}>{a}</a>)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--deep center">
    <div class="container">
      <h2>Ready for fresher, cleaner carpets?</h2>
      <p class="lead">Get a fast, free quote today — call, text or message us however suits you.</p>
      <div class="btn-row" style="justify-content:center;">
        <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> WhatsApp us</a>
        <a href={links.sms} class="btn btn--onDark"><Icon name="sms" size={17} /> Text us</a>
        <a href={links.tel} class="btn btn--onDark"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ waNumber: site.whatsappNumber }}>
    // Quote form → compose a WhatsApp message from the entered details
    const quoteForm = document.getElementById('quoteForm');
    quoteForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = (id) => (document.getElementById(id)?.value || '').trim();
      const name = val('qf-name'), phone = val('qf-phone');
      const postcode = val('qf-postcode'), message = val('qf-message');
      const lines = [
        'Hi On Target, I’d like a free quote for carpet cleaning.',
        name ? `Name: ${name}` : '',
        phone ? `Phone: ${phone}` : '',
        postcode ? `Postcode: ${postcode}` : '',
        message ? `Details: ${message}` : '',
      ].filter(Boolean);
      window.location.href = `https://wa.me/${waNumber}?text=` + encodeURIComponent(lines.join('\n'));
    });

    document.querySelectorAll('[data-ba]').forEach((ba) => {
      const range = ba.querySelector('.ba-range');
      const reveal = ba.querySelector('.ba-reveal');
      const handle = ba.querySelector('.handle');
      if (!range) return;
      const update = () => {
        const v = range.value;
        // reveal the BEFORE (dirty) image from the left edge up to the handle
        reveal.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
        handle.style.left = v + '%';
      };
      range.addEventListener('input', update);
      update();
    });

    // Animated count-up for the stats band
    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
    function animateStat(el) {
      const text = el.textContent.trim();
      const m = text.match(/^([\d,.]+)(.*)$/);
      if (!m) return;
      const target = parseFloat(m[1].replace(/,/g, ''));
      const decimals = m[1].includes('.') ? m[1].split('.')[1].length : 0;
      const suffix = m[2];
      const duration = 1100;
      const start = performance.now();
      function tick(now) {
        const p = Math.min((now - start) / duration, 1);
        const val = target * easeOutCubic(p);
        el.textContent = val.toLocaleString('en-GB', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    const statIo = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { animateStat(e.target); statIo.unobserve(e.target); }
      });
    }, { threshold: 0.4 });
    document.querySelectorAll('.stat .big').forEach((el) => statIo.observe(el));

    // Subtle mouse-parallax on the hero's floating decorative shapes
    const heroSection = document.querySelector('.hero');
    const heroBlobs = document.getElementById('heroBlobs');
    if (heroSection && heroBlobs && matchMedia('(hover: hover)').matches) {
      heroSection.addEventListener('mousemove', (e) => {
        const r = heroSection.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        heroBlobs.style.transform = `translate(${x * 24}px, ${y * 24}px)`;
      });
      heroSection.addEventListener('mouseleave', () => { heroBlobs.style.transform = ''; });
    }
  </script>
</Base>
