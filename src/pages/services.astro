---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { links, services, withBase } from '../config';
import Icon from '../components/Icon.astro';
---
<Base title="Carpet & Upholstery Cleaning Services" description="All our cleaning services in Leicester: carpet, upholstery, sofa, rug, mattress, curtain, pet stain and stain removal, plus commercial and end of tenancy cleans.">
  <section class="section">
    <div class="container center">
      <span class="eyebrow">Our services</span>
      <h1>Cleaning services we offer</h1>
      <p class="lead">Every service uses eco-friendly hot water extraction and comes with our satisfaction guarantee.</p>
    </div>
    <div class="container">
      <h2 class="sr-only">Our cleaning services</h2>
      <div class="grid grid--3">
        {services.map((s) => (
          <a href={withBase(`/services/${s.slug}`)} class="svc-card" style={s.img ? undefined : `background:${s.tint};`}>
            {s.img && <Image src={s.img} alt={s.alt} loading="lazy" width={700} format="webp" />}
            <div class="overlay"></div>
            <div class="body">
              <span class="chip">{s.icon} Service</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="center" style="margin-top:40px;">
        <div class="btn-row" style="justify-content:center;">
          <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> Get a quote on WhatsApp</a>
          <a href={withBase('/contact')} class="btn btn--primary">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
