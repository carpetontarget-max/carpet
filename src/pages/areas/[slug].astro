---
import Base from '../../layouts/Base.astro';
import { site, links, homeServices, whyChooseUs, withBase } from '../../config';
import { areaPages } from '../../areaPages';
import Icon from '../../components/Icon.astro';
import GoogleReviews from '../../components/GoogleReviews.astro';

export function getStaticPaths() {
  return areaPages.map((a) => ({
    params: { slug: a.slug },
    props: { area: a },
  }));
}

const { area } = Astro.props;
const nearbyAreas = area.nearby
  .map((slug: string) => areaPages.find((a) => a.slug === slug))
  .filter(Boolean);
---
<Base
  titleFull={`Carpet Cleaning in ${area.name} | ${site.businessName}`}
  description={`Professional carpet, upholstery and rug cleaning in ${area.name}, Leicestershire (${area.postcode}). Eco-friendly hot water extraction, fast drying, free quotes.`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Areas We Cover', path: '/areas/' },
    { name: area.name, path: `/areas/${area.slug}/` },
  ]}
>
  <!-- SUB-HERO -->
  <section class="subhero">
    <div class="container subhero-grid">
      <div class="reveal reveal--left">
        <span class="eyebrow">Serving {area.name}</span>
        <h1>Carpet &amp; upholstery cleaning in {area.name}</h1>
        <p class="lead" style="margin-left:0;">{area.blurb}</p>
        <div class="btn-row">
          <a href={links.whatsapp} class="btn btn--wa btn--lg"><Icon name="whatsapp" size={18} /> WhatsApp a quote</a>
          <a href={links.tel} class="btn btn--onDark btn--lg"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
        </div>
      </div>
      <div class="ph-photo reveal reveal--right">
        <span class="ph-cap">📷 A recent {area.name} clean — photo to follow</span>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Services in {area.name}</span>
        <h2>What we clean for {area.name} homes</h2>
        <p class="lead">Every service uses eco-friendly hot water extraction and comes with our satisfaction guarantee.</p>
      </div>
      <div class="grid grid--3">
        {homeServices.map((s) => (
          <a href={withBase(`/services/${s.slug}`)} class="card reveal" style="display:block;">
            <h3>{s.icon} {s.title}</h3>
            <p>{s.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="section section--mist">
    <div class="container">
      <div class="center reveal">
        <span class="eyebrow">Why {area.name} chooses us</span>
        <h2>A local, family-run team you can trust</h2>
      </div>
      <div class="grid grid--3">
        {whyChooseUs.map((w) => (
          <div class="card reveal">
            <span class="icon">{w.icon}</span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="section">
    <div class="container">
      <GoogleReviews />
    </div>
  </section>

  <!-- NEARBY AREAS -->
  {nearbyAreas.length > 0 && (
    <section class="section section--mist">
      <div class="container center">
        <span class="eyebrow">Also nearby</span>
        <h2>We also cover</h2>
        <div class="areas" style="justify-content:center;max-width:820px;margin:24px auto 0;">
          {nearbyAreas.map((a) => a && <a href={withBase(`/areas/${a.slug}`)}>{a.name}</a>)}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section section--deep center">
    <div class="container">
      <h2>Ready for fresher, cleaner carpets in {area.name}?</h2>
      <p class="lead">Get a fast, free quote today — send a photo on WhatsApp for the quickest price.</p>
      <div class="btn-row" style="justify-content:center;">
        <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> WhatsApp us</a>
        <a href={links.tel} class="btn btn--onDark"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Base>
