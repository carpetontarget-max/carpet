---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site, links, services, homeServices, pricing, withBase, businessSchemaId, responsive } from '../../config';
import { areaPages } from '../../areaPages';
import Icon from '../../components/Icon.astro';

export function getStaticPaths() {
  return areaPages.map((a) => ({
    params: { slug: a.slug },
    props: { area: a },
  }));
}

const { area } = Astro.props;
const nearbyAreas = area.nearby
  .map((slug: string) => areaPages.find((a) => a.slug === slug))
  .filter(Boolean);
const popular = area.popular
  .map((p) => ({ why: p.why, service: services.find((s) => s.slug === p.slug) }))
  .filter((p) => p.service);

// Real job photo for the hero: rotate through the home-service photos so
// neighbouring area pages don't all open with the same image. Skip small
// photos — they'd be upscaled to hero size and look soft.
const heroPool = homeServices.filter((s) => s.img && s.img.width >= 800);
const heroService = heroPool[areaPages.findIndex((a) => a.slug === area.slug) % heroPool.length];

const fromPrice = pricing[0].price; // "Single Room" tier

// One-line trust strip (replaces the six "why choose us" cards on town pages).
const trustStrip = ['🛡️ Fully insured & DBS-checked', '🌿 Safe for kids & pets', '💧 Dry in 4–6 hours', '✅ Satisfaction guarantee'];

const areaSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Carpet & upholstery cleaning in ${area.name}`,
  serviceType: 'Carpet cleaning',
  url: String(new URL(withBase(`/areas/${area.slug}`), Astro.site)),
  provider: { '@id': businessSchemaId(Astro.site) },
  areaServed: { '@type': 'City', name: area.name },
};
---
<Base
  titleFull={area.metaTitle ?? `Carpet Cleaning ${area.name} | Sofa & Upholstery Cleaning | On Target`}
  description={area.metaDescription ?? `Carpet, sofa and upholstery cleaning in ${area.name} (${area.postcode}). Rated ${site.googleRating.toFixed(1)}★ from ${site.googleReviewCount} Google reviews, from £${fromPrice} a room, dry in 4–6 hours. Free quotes.`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Areas We Cover', path: '/areas/' },
    { name: area.name, path: `/areas/${area.slug}/` },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(areaSchema)} />

  <!-- SUB-HERO -->
  <section class="subhero">
    <div class="container subhero-grid">
      <div class="reveal reveal--left">
        <span class="eyebrow">Serving {area.name}</span>
        <h1>{area.h1 ?? `Carpet & upholstery cleaning in ${area.name}`}</h1>
        <p class="lead" style="margin-left:0;">{area.blurb}</p>
        <div class="btn-row">
          <a href={links.whatsapp} class="btn btn--wa btn--lg"><Icon name="whatsapp" size={18} /> WhatsApp a quote</a>
          <a href={links.tel} class="btn btn--onDark btn--lg"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
        </div>
      </div>
      <Image
        src={heroService.img!}
        alt={heroService.alt}
        loading="eager"
        fetchpriority="high"
        width={800}
        {...responsive.hero}
        format="webp"
        class="reveal reveal--right"
        style="width:100%;height:auto;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);object-fit:cover;aspect-ratio:4/3;"
      />
    </div>
  </section>

  <!-- LOCAL NOTES (unique per area — see areaPages.ts) -->
  <section class="section">
    <div class="container" style="max-width:820px;">
      <div class="reveal">
        <span class="eyebrow">Local know-how</span>
        <h2>Carpet cleaning in {area.name}: what to know</h2>
        {area.localNotes.map((p) => <p>{p}</p>)}

        {area.neighbourhoods && (
          <>
            <h3 class="area-sub">Areas of {area.name} we cover</h3>
            <div class="areas">{area.neighbourhoods.map((n) => <span>{n}</span>)}</div>
          </>
        )}

        {/* Real local proof — only rendered once the owner supplies it (see areaPages.ts). */}
        {(area.localJob || area.customerQuote) && (
          <div class="local-proof">
            {area.localJob && (
              <>
                <h3>{area.localJob.title}</h3>
                <p>{area.localJob.text}</p>
              </>
            )}
            {area.customerQuote && (
              <blockquote class="local-quote">
                <p>“{area.customerQuote.text}”</p>
                <cite>— {area.customerQuote.name}, {area.name}</cite>
              </blockquote>
            )}
          </div>
        )}

        {/* Supporting link: the homepage is the page we want ranking for
            "carpet cleaning leicester", so every town page points at it. */}
        <p class="area-home-link">
          We're a family-run <a href={withBase('/')}>carpet cleaning company based in Leicester</a> —
          see how it works, our prices and what customers say.
        </p>
        <p class="area-rating">
          <span class="rating-stars" aria-hidden="true">★★★★★</span>
          Rated {site.googleRating.toFixed(1)} from {site.googleReviewCount} Google reviews —
          <a href={site.googleReviewsUrl} target="_blank" rel="noopener">read them on Google</a>
        </p>
        <div class="areas area-trust">
          {trustStrip.map((t) => <span>{t}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- RECOMMENDED FOR THIS AREA -->
  {popular.length > 0 && (
    <section class="section section--mist">
      <div class="container">
        <div class="center reveal">
          <span class="eyebrow">Recommended in {area.name}</span>
          <h2>The right clean for {area.name}</h2>
        </div>
        <div class="grid grid--3">
          {popular.map(({ service, why }) => service && (
            <a href={withBase(`/services/${service.slug}`)} class="feature-card reveal">
              <div class="feature-card__media">
                {service.img && (
                  <Image src={service.img} alt={service.alt} width={700} {...responsive.card} format="webp" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
                )}
              </div>
              <div class="feature-card__body">
                <h3>{service.icon} {service.title}</h3>
                <p>{why}</p>
                <span class="feature-card__more">Learn more →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SERVICES + NEARBY: compact link lists. Kept short on purpose — the
       full service descriptions, reasons and reviews live on other pages, and
       repeating them on every town page made the 14 pages ~72% identical. -->
  <section class="section">
    <div class="container center">
      <span class="eyebrow">Services in {area.name}</span>
      <h2>Everything we clean in {area.name}</h2>
      <p class="lead">Single rooms from £{fromPrice} — every clean uses eco-friendly hot water extraction.</p>
      <div class="areas" style="justify-content:center;max-width:900px;margin:0 auto;">
        {services.map((s) => <a href={withBase(`/services/${s.slug}`)}>{s.title}</a>)}
      </div>
      {nearbyAreas.length > 0 && (
        <>
          <h3 class="area-sub" style="margin-top:44px;">Also nearby</h3>
          <div class="areas" style="justify-content:center;max-width:820px;margin:0 auto;">
            {nearbyAreas.map((a) => a && <a href={withBase(`/areas/${a.slug}`)}>{a.name}</a>)}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--deep center">
    <div class="container">
      <h2>Ready for fresher, cleaner carpets in {area.name}?</h2>
      <p class="lead">Get a fast, free quote today — send a photo on WhatsApp for the quickest price.</p>
      <div class="btn-row" style="justify-content:center;">
        <a href={links.whatsapp} class="btn btn--wa"><Icon name="whatsapp" size={17} /> WhatsApp us</a>
        <a href={links.tel} class="btn btn--onDark"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Base>
