---
// Short link to send customers after a job: ontargetcarpetcleaning.co.uk/review
// Sends them straight to the Google review form for the Business Profile.
// To change where it goes, edit googleWriteReviewUrl in src/config.ts.
import { site } from '../config';
const url = site.googleWriteReviewUrl;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <title>Leave us a review | {site.googleBusinessName}</title>
    <script is:inline define:vars={{ url }}>window.location.replace(url);</script>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center;">
    <p>Taking you to our Google review page...</p>
    <p><a href={url}>Tap here if it doesn't open</a></p>
  </body>
</html>
